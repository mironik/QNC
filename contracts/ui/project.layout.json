      "true_peak": [["-1", "-1 (EBU R 128)"], ["-2", "-2"], ["-3", "-3"]],
      "loudness_tolerance": [["0.5", "0.5"], ["1", "1"]],
      "start_timecodes": [["10:00:00:00", "10:00:00:00"], ["01:00:00:00", "01:00:00:00"], ["00:00:00:00", "00:00:00:00"]],
      "tail_seconds": [["0", "0"], ["1", "1"], ["2", "2"], ["3", "3"], ["5", "5"], ["10", "10"]],
