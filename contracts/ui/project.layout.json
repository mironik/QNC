    "sections": [
      {
        "title": "Input source",
        "fields": [
          {
            "kind": "choice",
            "label": "Mode",
            "id": "pts_input_mode",
            "path": "input.mode",
            "options": "input_modes",
            "default": "auto"
          },
          {
            "kind": "choice",
            "label": "Ingest profil",
            "id": "pts_ingest_profile",
            "path": "storage.ingest_profile",
            "options": "ingest_profiles",
            "default": "field"
          },
          {
            "kind": "choice",
            "label": "Ingest media",
            "id": "pts_ingest_media",
            "path": "storage.ingest_media",
            "options": "ingest_media",
            "default": ""
          },
          {
            "kind": "choice",
            "label": "Playback input",
            "id": "pts_playback_input",
            "path": "playback.input",
            "options": "playback_inputs",
            "default": ""
          }
        ],
        "then": {
          "when": {
            "path": "input.mode",
            "equals": "manual",
            "default": "auto"
          },
          "fields": [
            {
              "kind": "choice",
              "label": "Format",
              "id": "pts_input_format",
              "path": "input.format",
              "options": "formats",
              "default": ""
            },
            {
              "kind": "number",
              "label": "Frame rate",
              "id": "pts_input_fps",
              "path": "input.fps",
              "options": "fps"
            },
            {
              "kind": "integer",
              "label": "Width",
              "id": "pts_input_width",
              "path": "input.width"
            },
            {
              "kind": "integer",
              "label": "Height",
              "id": "pts_input_height",
              "path": "input.height"
            },
            {
              "kind": "choice",
              "label": "Field order",
              "id": "pts_input_field",
              "path": "input.field_order",
              "options": "field_order",
              "default": ""
            },
            {
              "kind": "choice",
              "label": "Color space",
              "id": "pts_input_cs",
              "path": "input.color_space",
              "options": "color_space",
              "default": ""
            }
          ]
        }
      },
      {
        "title": "Tipkovnica",
        "block": "keyboard_preset",
        "label": "Preset tipki"
      },
      {
        "title": "Export",
        "fields": [
          {
            "kind": "choice",
            "label": "Mode",
            "id": "pts_export_mode",
            "path": "export.default_mode",
            "options": "export_modes",
            "default": "xml_master"
          },
          {
            "kind": "choice",
            "label": "Original policy",
            "id": "pts_orig_policy",
            "path": "storage.original_policy",
            "options": "original_policies",
            "default": "link_when_available"
          }
        ]
      },
      {
        "title": "Export format",
        "block": "export_preset",
        "label": "Preset",
        "then": {
          "when": {
            "path": "export.preset",
            "equals": "manual",
            "default": "manual"
          },
          "fields": [
            {
              "kind": "choice",
              "label": "Format",
              "id": "pts_export_format",
              "path": "export.format",
              "options": "formats",
              "default": ""
            },
            {
              "kind": "number",
              "label": "Frame rate",
              "id": "pts_export_fps",
              "path": "export.fps",
              "options": "fps"
            },
            {
              "kind": "integer",
              "label": "Width",
              "id": "pts_export_width",
              "path": "export.width"
            },
            {
              "kind": "integer",
              "label": "Height",
              "id": "pts_export_height",
              "path": "export.height"
            },
            {
              "kind": "choice",
              "label": "Field order",
              "id": "pts_export_field",
              "path": "export.field_order",
              "options": "field_order",
              "default": ""
            },
            {
              "kind": "choice",
              "label": "Color space",
              "id": "pts_export_cs",
              "path": "export.color_space",
              "options": "color_space",
              "default": ""
            },
            {
              "kind": "choice",
              "label": "Container",
              "id": "pts_export_container",
              "path": "export.container",
              "options": "containers",
              "default": ""
            },
            {
              "kind": "choice",
              "label": "Video codec",
              "id": "pts_export_codec",
              "path": "export.video_codec",
              "options": "video_codecs",
              "default": ""
            },
            {
              "kind": "integer",
              "label": "Audio",
              "id": "pts_export_arate",
              "path": "export.audio_sample_rate",
              "options": "audio_rates"
            },
            {
              "kind": "integer",
              "label": "Channels",
              "id": "pts_export_ach",
              "path": "export.audio_channels",
              "options": "audio_channels"
            }
          ],
          "save_preset": true
        }
      },
      {
        "title": "Plugin tabovi u workflowu",
        "block": "applications"
      }
    ],
