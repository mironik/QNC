          "@project.optimised_if_available"
        ]
      ],
      "export_modes": [
        [
          "xml_master",
          "@project.xml_master"
        ],
        [
          "xdcam",
          "@project.xdcam"
        ],
        [
          "original",
          "@project.original"
        ],
        [
          "avid",
          "@project.avid"
        ]
      ],
      "original_policies": [
        [
          "link_when_available",
          "@project.link"
        ],
        [
          "copy_background",
          "@project.copy_background"
        ],
        [
          "ignore_for_fast_news",
          "@project.ignore_fast_news"
        ]
      ],
