    "new_template": "@project.new_template",
    "template_base": "@project.base_base",
    "template_name_label": "@project.template_name",
    "template_name_hint": "@project.name_new_template",
    "save": "@project.save",
    "short_description_hint": "@project.short_description",
    "projects_root_label": "@project.projects_location",
    "export_directory_label": "@project.export_folder",
    "sources": "@source.sources",
    "up": "@story.ui.up",
    "disks": "@source.disks",
    "internet": "@source.internet",
    "empty_lan": "@project.no_lan_sources_are_configured",
    "empty_internet": "@project.no_internet_sources_are_configured",
    "empty_folder": "@source.empty_folder",
    "empty_disks": "@source.empty_local",
    "remove_project_hint": "@project.remove_project",
    "delete_project_question": "@project.remove_project_2",
    "delete_template_question": "@project.remove_template"
  },
  "labels": [
    "@project.project",
    "@project.projects",
    "@project.settings",
    "@project.workflow",
    "@project.project_name",
    "@project.new_project",
    "@project.ai",
    "@project.projects_location",
    "@project.export_folder",
    "@project.new_template",
