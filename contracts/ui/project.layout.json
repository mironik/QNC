    "@project.save_new_template",
    "×",
    "@project.remove_project_2",
    "@project.yes",
    "@project.no"
  ],
  "forbidden_changes_without_approval": [
    "redesign",
    "moving_project_list_to_right",
    "changing_pts_slot_order",
    "changing_labels",
    "changing_font_system",
    "adding_business_logic_to_ui"
  ]
