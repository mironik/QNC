        ]
      ],
      "ingest_profiles": [
        [
          "field",
          "@project.field"
        ],
        [
          "house",
          "@project.tv_house"
        ]
      ],
      "ingest_media": [
        [
          "link",
          "@project.link_only"
        ],
        [
          "proxy",
          "@project.proxy"
        ],
        [
          "original",
          "@project.original"
        ],
        [
          "optimized",
          "@project.optimised_h_264_8_bit"
        ],
        [
