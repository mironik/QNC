        ],
        [
          "8",
          "8"
        ]
      ]
    },
    "sections": [
      {
        "title": "@project.input_source",
        "fields": [
          {
            "kind": "choice",
            "label": "@project.mode",
            "id": "pts_input_mode",
            "path": "input.mode",
            "options": "input_modes",
            "default": "auto"
          },
          {
            "kind": "choice",
            "label": "@project.ingest_profile",
            "id": "pts_ingest_profile",
            "path": "storage.ingest_profile",
            "options": "ingest_profiles",
            "default": "field"
          },
          {
            "kind": "choice",
            "label": "@project.ingest_media",
            "id": "pts_ingest_media",
            "path": "storage.ingest_media",
            "options": "ingest_media",
            "default": ""
          },
          {
            "kind": "choice",
            "label": "@project.playback_input",
            "id": "pts_playback_input",
            "path": "playback.input",
            "options": "playback_inputs",
            "default": ""
          }
        ],
        "then": {
          "when": {
            "path": "input.mode",
            "equals": "manual",
            "default": "auto"
          },
          "fields": [
            {
              "kind": "choice",
              "label": "@project.format",
              "id": "pts_input_format",
              "path": "input.format",
              "options": "formats",
              "default": ""
            },
            {
              "kind": "number",
              "label": "@project.frame_rate",
              "id": "pts_input_fps",
              "path": "input.fps",
              "options": "fps"
            },
            {
              "kind": "integer",
              "label": "@project.width",
              "id": "pts_input_width",
              "path": "input.width"
            },
            {
              "kind": "integer",
              "label": "@project.height",
              "id": "pts_input_height",
              "path": "input.height"
            },
            {
              "kind": "choice",
              "label": "@project.field_order",
              "id": "pts_input_field",
              "path": "input.field_order",
              "options": "field_order",
              "default": ""
            },
            {
              "kind": "choice",
              "label": "@project.color_space",
              "id": "pts_input_cs",
              "path": "input.color_space",
              "options": "color_space",
              "default": ""
            }
          ]
        }
      },
      {
        "title": "@project.audio_edit",
        "fields": [
          {
            "kind": "integer",
            "label": "@project.crossfade_frames",
            "id": "pts_audio_crossfade",
            "path": "audio.crossfade_frames",
            "options": "crossfade_frames"
          }
        ]
      },
      {
        "title": "@project.loudness",
        "fields": [
          {
            "kind": "number",
            "label": "@project.a1_lufs",
            "id": "pts_loudness_a1",
            "path": "audio.loudness.a1_lufs",
            "options": "lufs"
          },
          {
            "kind": "number",
            "label": "@project.a2_lufs",
            "id": "pts_loudness_a2",
            "path": "audio.loudness.a2_lufs",
            "options": "lufs"
          },
          {
            "kind": "number",
            "label": "@project.true_peak",
            "id": "pts_loudness_peak",
            "path": "audio.loudness.true_peak_dbtp",
            "options": "true_peak"
          },
          {
            "kind": "number",
            "label": "@project.loudness_tolerance",
            "id": "pts_loudness_tolerance",
            "path": "audio.loudness.tolerance_lu",
            "options": "loudness_tolerance"
          }
        ]
      },
      {
        "title": "@project.keyboard",
        "block": "keyboard_preset",
        "label": "@project.key_preset"
      },
      {
        "title": "@common.export",
        "fields": [
          {
            "kind": "number",
            "label": "@project.lead_in_seconds",
            "id": "pts_export_lead_in",
            "path": "export.lead_in_seconds",
            "options": "tail_seconds"
          },
          {
            "kind": "number",
            "label": "@project.tail_seconds",
            "id": "pts_export_tail",
            "path": "export.tail_seconds",
            "options": "tail_seconds"
          },
          {
            "kind": "choice",
            "label": "@project.start_timecode",
            "id": "pts_export_start_tc",
            "path": "export.start_timecode",
            "options": "start_timecodes"
          },
          {
            "kind": "choice",
            "label": "@project.mode",
            "id": "pts_export_mode",
            "path": "export.default_mode",
            "options": "export_modes",
            "default": "xml_master"
          },
          {
            "kind": "choice",
            "label": "@project.original_policy",
            "id": "pts_orig_policy",
            "path": "storage.original_policy",
            "options": "original_policies",
            "default": "link_when_available"
          }
        ]
      },
      {
        "title": "@project.export_format",
        "block": "export_preset",
        "label": "@project.preset",
        "then": {
          "when": {
            "path": "export.preset",
            "equals": "manual",
            "default": "manual"
          },
          "fields": [
            {
              "kind": "choice",
              "label": "@project.format",
              "id": "pts_export_format",
              "path": "export.format",
              "options": "formats",
              "default": ""
            },
            {
              "kind": "number",
              "label": "@project.frame_rate",
              "id": "pts_export_fps",
              "path": "export.fps",
              "options": "fps"
            },
            {
              "kind": "integer",
              "label": "@project.width",
              "id": "pts_export_width",
              "path": "export.width"
            },
            {
              "kind": "integer",
              "label": "@project.height",
              "id": "pts_export_height",
              "path": "export.height"
            },
            {
              "kind": "choice",
              "label": "@project.field_order",
              "id": "pts_export_field",
              "path": "export.field_order",
              "options": "field_order",
              "default": ""
            },
            {
              "kind": "choice",
              "label": "@project.color_space",
              "id": "pts_export_cs",
              "path": "export.color_space",
              "options": "color_space",
              "default": ""
            },
            {
              "kind": "choice",
              "label": "@project.container",
              "id": "pts_export_container",
              "path": "export.container",
              "options": "containers",
              "default": ""
            },
            {
              "kind": "choice",
              "label": "@project.video_codec",
              "id": "pts_export_codec",
              "path": "export.video_codec",
              "options": "video_codecs",
              "default": ""
            },
            {
              "kind": "integer",
              "label": "@project.audio",
              "id": "pts_export_arate",
              "path": "export.audio_sample_rate",
              "options": "audio_rates"
            },
            {
              "kind": "integer",
              "label": "@project.channels",
              "id": "pts_export_ach",
              "path": "export.audio_channels",
              "options": "audio_channels"
            }
          ],
          "save_preset": true
        }
      },
      {
        "title": "@project.plugin_tabs_workflow",
        "block": "applications"
      }
    ],
    "keyboard_preset_order": [
      "default",
      "resolve",
      "premiere",
      "finalcut",
      "edius",
      "avid"
    ],
    "texts": {
      "manual_preset": "@project.manual",
      "new_preset_hint": "@project.name_new_preset",
      "save_preset": "@project.save_template",
      "no_selection": "@project.none",
