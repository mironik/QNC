    "left_ratio": 0.31,
    "divider_width": 5.0,
    "left_min_width": 280.0,
    "right_min_width": 200.0,
    "monitor_height": 1.0,
    "head_height": 1.0,
    "dock_height": 1.0,
    "outer_padding": 0.0,
    "body_face": "theme.bg"
  },
  "left_project_list": {
    "panel_pad": 20.0,
    "title": "Projekti",
    "title_row_height": 28.0,
    "below_title_pad": 40.0,
    "row_height": 60.0,
    "row_gap": 10.0,
    "delete_column_width": 28.0,
    "column_gap": 8.0,
    "confirm_button_width": 28.0,
    "confirm_button_height": 22.0,
    "empty_text": "Nema projekata.",
    "ready_text": "Spreman."
  },
  "right_settings_panel": {
    "panel_pad": 20.0,
    "title": "Postavke",
    "subtitle": "Odaberi radni tok i pregledaj postavke projekta.",
    "inner_pad_x": 8.0,
    "inner_pad_y": 8.0,
    "section_gap": 8.0,
    "inline_label_width": 168.0,
    "inline_button_width": 120.0,
    "inline_column_gap": 8.0,
    "field_min_width": 160.0,
    "label_font_size": 12.0,
    "group_title_font_size": 12.0,
    "row_height": 24.0
  },
  "ai_switches": [
    {"path": "ai.enabled", "on": true, "off": false, "default_on": false, "label": "AI analiza kadrova i virtualni kadrovi"},
    {"path": "ai.coverage_suggestions", "on": true, "off": false, "default_on": true, "label": "Coverage suggestions"},
    {"path": "ai.transcription", "on": true, "off": false, "default_on": false, "label": "Transkripcija u Media tabu"},
    {"path": "artifacts.filmstrip", "on": "auto", "off": "off", "default_on": true, "label": "Filmstrip automatski nakon Odaberi"}
  ],
