        [
          "rec2020",
          "rec2020"
        ]
      ],
      "containers": [
        [
          "mxf_op1a",
          "@project.mxf_op1a"
        ],
        [
          "mp4",
          "@project.mp4"
        ],
        [
          "mov",
          "@project.mov"
        ]
      ],
