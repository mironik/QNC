    "show_header": true,
    "show_edit_actions": false,
    "show_import_actions": true,
    "header_timeline_gap": 4.0,
    "inner_margin_x": 8.0,
    "font_ui": 14.0,
    "header_item_gap": 8.0,
    "clip_label_fallback": "—",
    "header_left": ["clip_label", "ingest_status"],
    "actions_rtl": [
      "AI mining",
      "Kopiraj original",
      "Očisti",
      "Odaberi sve",
      "Uvezi",
      "Generiraj postere",
