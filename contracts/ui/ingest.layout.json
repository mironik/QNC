    "kind_gap": 10.0,
    "up_label": "Gore",
    "up_width": 42.0,
    "disks_label": "Diskovi",
    "disks_width": 58.0,
    "nav_gap": 12.0,
    "error_gap": 4.0,
    "tree_footer_gap": 8.0,
    "tree_footer_reserve": 32.0,
    "tree_min_height": 40.0,
    "confirm_label": "Odaberi",
    "cancel_label": "Odustani",
    "footer_item_gap": 8.0,
    "empty_lan": "Nema konfiguriranih LAN izvora.",
    "empty_internet": "Nema konfiguriranih Internet izvora."
