{
  "module_id": "qnc.module.content-read",
  "module_name": "Project content read (public views of the content DB contract, read-only)",
  "module_version": "0.1.0",
  "module_kind": "library",
  "capabilities": ["content.clips.list", "content.clip.head", "content.filmstrip.read", "content.wave.read", "content.catalog.signature"],
  "input_contract_version": "0.1.0",
  "output_contract_version": "0.1.0",
  "supported_os": ["windows", "linux", "macos"],
  "supported_cpu": ["x86_64", "aarch64"],
  "transport_protocol_version": "0.1.0",
  "forbidden_calls": ["application.start", "business.db.write", "workflow.run", "media.process", "media.scan", "media.probe", "filesystem.write"],
  "forbidden_dependencies": ["qnc.module.media-probe", "qnc.module.scanner"],
  "state_policy": "stateless",
  "database_write_policy": "no_db_writes"
}
