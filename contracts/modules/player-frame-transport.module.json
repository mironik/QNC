{
  "module_id": "qnc.module.player-frame-transport",
  "module_name": "Player Frame Transport",
  "module_version": "0.1.0",
  "module_kind": "library",
  "implementation_stage": "local_ordered_frame_transport",
  "capabilities": ["playback.monitor.frame.write_ordered", "playback.monitor.frame.read_ordered", "playback.monitor.clear"],
  "timing_policy": "Ordered monitor frame records carry source timebase, session, source generation and frame identity. The transport does not own playback time, display refresh or a 60 Hz fallback. It may skip only overwritten history in the bounded local ring; latest-only mode is not the main playback proof.",
  "input_contract_version": "0.3.0",
  "output_contract_version": "0.3.0",
  "supported_os": ["windows", "linux", "macos"],
  "supported_cpu": ["x86_64", "aarch64"],
  "transport_protocol_version": "0.3.0",
  "transport_scope": ["local"],
  "forbidden_calls": ["ffprobe", "media.probe.full", "source.scan.roles", "playback.clock.own", "playback.decode", "application.db.read", "application.db.write", "app_to_app.state_share"],
  "forbidden_dependencies": ["qnc.module.media-probe", "qnc.module.scanner", "qnc.module.media-decode", "qnc.module.broadcast-engine", "qnc.module.ui-widget"],
  "state_policy": "session_local",
  "database_write_policy": "no_db_writes"
}
