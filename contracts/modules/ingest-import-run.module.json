{
  "module_id": "qnc.module.ingest-import-run",
  "module_name": "Ingest import run",
  "module_version": "0.1.0",
  "module_kind": "library",
  "capabilities": ["ingest.import.start", "ingest.import.choice", "ingest.import.wake-worker"],
  "input_contract_version": "0.1.0",
  "output_contract_version": "0.1.0",
  "supported_os": ["windows", "linux", "macos"],
