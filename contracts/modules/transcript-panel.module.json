{
  "module_id": "qnc.module.transcript-panel",
  "module_name": "Transcript Panel",
  "module_version": "0.1.0",
  "module_kind": "library",
  "capabilities": ["ui.transcript.paint"],
  "input_contract_version": "0.1.0",
