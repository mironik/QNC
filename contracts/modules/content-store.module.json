{
  "module_id": "qnc.module.content-store",
  "module_name": "Project content database store",
  "module_version": "0.1.0",
  "module_kind": "library",
  "capabilities": ["project.content.store", "project.content.transport"],
  "input_contract_version": "0.2.0",
  "output_contract_version": "0.2.0",
  "supported_os": ["windows", "linux", "macos"],
  "supported_cpu": ["x86_64", "aarch64"],
  "transport_protocol_version": "0.1.0",
  "forbidden_calls": ["ffprobe", "source.scan.roles", "business.workflow", "player.command", "ui.paint"],
  "forbidden_dependencies": ["qnc.module.media-probe", "qnc.module.scanner"],
  "state_policy": "owned_by_calling_application",
  "database_write_policy": "public_db_owner_write_adapter_only",
  "runtime_crate": "qnc-content-store",
  "input": "An active project workspace database URI plus the owner-supplied local or remote binding.",
  "output": "Clip catalog, selection/import queue, runtime markers, filmstrip artifacts and wave artifacts through the public content transport.",
  "specification": "AGENTS.md §0, §4.1, §8; docs/96-v5-ingest-db-and-workers.md"
}
