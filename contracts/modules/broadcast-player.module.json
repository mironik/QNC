{
  "module_id": "qnc.module.broadcast-player",
  "module_name": "Broadcast Player",
  "module_version": "0.1.0",
  "module_kind": "out_of_process_helper",
  "implementation_stage": "process_control_and_local_frame_map_monitor",
  "runtime_available": true,
  "native_control_available": true,
  "executable": "qnc-broadcast-player",
  "crate": "qnc-player-runner",
  "endpoint": "/v1/player",
  "output_scope": "native_or_local_frame_map_monitor; audio_on_player_host_device; remote_audio_device_pending",
  "wire_protocol": "qnc-player+tcp",
  "monitor_frame_transport": "qnc-player-frame-map",
  "core_module": "qnc.module.broadcast-player-core",
  "contract_module": "qnc.module.player-contract",
  "decoder_catalog_module": "qnc.module.decoder-catalog",
  "decoder_contract_module": "qnc.module.media-decode",
  "decoder_selection": "explicit_host_catalog_no_fallback",
  "capabilities": ["playback.open", "playback.seek", "playback.status", "playback.play", "playback.pause", "playback.stop", "playback.shutdown", "playback.monitor.frame_ordered"],
  "timing_policy": "The process publishes monitor frames with the saved source timebase. It may run beside a 50 fps, 60 fps or fractional-fps source, but it must never impose a fixed 60 Hz/16 ms UI cadence.",
  "input_contract_version": "0.3.0",
  "output_contract_version": "0.3.0",
  "supported_os": ["windows", "linux", "macos"],
  "supported_cpu": ["x86_64", "aarch64"],
  "transport_protocol_version": "0.3.0",
  "forbidden_calls": ["ffprobe", "media.probe.full", "source.scan.roles", "export.render", "app_to_app.state_share"],
  "forbidden_dependencies": ["qnc.module.media-probe", "qnc.module.scanner", "qnc.module.export"],
  "state_policy": "session_local",
  "database_write_policy": "no_db_writes"
}
