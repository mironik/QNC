  "state_policy": "stateless",
  "database_write_policy": "no_db_writes",
  "runtime_crate": "qnc-text-source-editor",
  "input": "The text to show, a title, an info line, a hint and the caller buttons (label, action id, enabled).",
  "output": "The whole new text when typing changed it, or the action of a pressed button.",
