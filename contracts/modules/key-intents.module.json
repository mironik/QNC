{
  "module_id": "qnc.module.key-intents",
  "module_name": "Key intents",
  "module_version": "0.1.0",
  "module_kind": "library",
  "capabilities": [
    "keyboard.frame_action_ids"
  ],
  "input_contract_version": "0.1.0",
  "output_contract_version": "0.1.0",
  "supported_os": [
    "windows",
    "linux",
    "macos"
  ],
  "supported_cpu": [
    "x86_64",
    "aarch64"
  ],
  "transport_protocol_version": "0.1.0",
