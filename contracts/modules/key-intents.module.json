    "player.command",
    "database.read",
    "database.write"
  ],
  "forbidden_dependencies": [
    "qnc.module.media-probe",
    "qnc.module.scanner",
    "qnc.module.content-store"
  ],
  "state_policy": "stateless",
  "database_write_policy": "no_db_writes",
  "runtime_crate": "qnc-key-intents",
  "input": "The keys of one frame, the external keyboard catalog, the scopes of a board and its play action.",
  "output": "The catalog action ids of the frame in order (play presses first, then each key once per action). The caller turns them into its own intents.",
