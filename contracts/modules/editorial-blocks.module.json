{
  "module_id": "qnc.module.editorial-blocks",
  "module_name": "Editorial blocks",
  "module_version": "0.1.0",
  "module_kind": "library",
  "capabilities": [
    "ui.editorial.preview",
    "ui.editorial.pool_head",
    "ui.editorial.clip_cards",
    "ui.editorial.right_panel",
    "ui.editorial.source_dock"
  ],
  "input_contract_version": "0.1.0",
  "output_contract_version": "0.1.0",
  "supported_os": [
    "windows",
    "linux",
    "macos"
  ],
  "supported_cpu": [
    "x86_64",
    "aarch64"
  ],
  "transport_protocol_version": "0.1.0",
  "forbidden_calls": [
    "ffprobe",
    "media.decode",
    "source.scan.roles",
    "player.command",
    "database.read",
    "database.write"
  ],
  "forbidden_dependencies": [
    "qnc.module.media-probe",
    "qnc.module.scanner",
    "qnc.module.content-store"
  ],
  "state_policy": "stateless",
  "database_write_policy": "no_db_writes",
  "runtime_crate": "qnc-editorial-blocks",
  "input": "The editorial layout contract of a group, the theme and the editorial view.",
  "output": "The Media Assist and Story blocks on the desktop board (preview, pool head, clip cards, the group right panel with Segmenti for Story, source dock) and the EditorialIntents they ask for. They draw only.",
  "specification": "User rule 2026-09-30: forms are boards of blocks; moved unchanged from qnc-editorial-desktop."
}
