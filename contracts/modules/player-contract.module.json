{
  "module_id": "qnc.module.player-contract",
  "module_name": "Player Contract",
  "module_version": "0.3.0",
  "module_kind": "library",
  "capabilities": ["playback.contract.validate", "playback.envelope.validate"],
  "timing_policy": "Player and monitor frame contracts carry the saved source clip timebase. Display refresh rate, 60 Hz assumptions, 16 ms repaint loops and project/export FPS are not playback cadence.",
  "input_contract_version": "0.3.0",
  "output_contract_version": "0.3.0",
  "supported_os": ["windows", "linux", "macos"],
  "supported_cpu": ["x86_64", "aarch64"],
  "transport_protocol_version": "0.3.0",
  "forbidden_calls": ["ffprobe", "media.probe.full", "source.scan.roles", "playback.execute", "application.db.read", "application.db.write"],
  "forbidden_dependencies": ["qnc.module.media-probe", "qnc.module.scanner", "qnc.module.broadcast-player-core"],
  "state_policy": "stateless",
  "database_write_policy": "no_db_writes"
}
