{
  "module_id": "qnc.module.title-card",
  "module_name": "Title Card",
  "module_version": "0.1.0",
  "module_kind": "library",
  "capabilities": ["image.render.title_card"],
  "input_contract_version": "0.1.0",
  "output_contract_version": "0.1.0",
  "transport_protocol_version": "0.1.0",
  "transport_scope": ["local", "lan", "intranet"],
  "supported_os": ["windows", "linux", "macos"],
  "supported_cpu": ["x86_64", "aarch64"],
  "forbidden_calls": ["ffprobe", "media.decode", "media.probe.full", "database.read", "database.write", "playback.clock"],
  "forbidden_dependencies": ["qnc.module.media-probe", "qnc.module.scanner", "qnc.module.broadcast-player-core"],
  "state_policy": "session_local",
  "database_write_policy": "no_db_writes",
  "runtime_crate": "qnc-title-card",
  "input": "A text, a small heading and the project picture size.",
  "output": "A picture of white text on black (the QNC interface font, wrapped, made smaller until it fits), as an image or a PNG file.",
  "specification": "User 2026-10-28: the picture of a recorded voice-over clip (AGENTS.md)."
}
