{
  "module_id": "qnc.module.media-records",
  "module_name": "Media Record Contract",
  "module_version": "0.2.0",
  "module_kind": "library",
  "input_contract_version": "0.2.0",
  "output_contract_version": "0.2.0",
  "transport_protocol_version": "0.1.0",
  "supported_os": [
    "windows",
    "linux",
    "macos"
  ],
  "supported_cpu": [
    "x86_64",
    "aarch64"
  ],
  "capabilities": [
    "media.records.validate",
    "media.documents.snapshot"
  ],
  "camera_document_policy": "Pure content-addressed XML evidence: SHA-256 body version under the original QNC authority and source identity/path. Validate against the confirmed recording documents. No source I/O, mutation or second probe.",
  "state_policy": "stateless",
  "database_write_policy": "no_db_writes",
  "forbidden_calls": [
    "filesystem.read",
    "network.request",
    "db.write",
    "source.scan.roles",
    "media.probe.full",
    "ffprobe",
    "business.workflow"
  ],
  "forbidden_dependencies": [
    "qnc.module.scanner",
    "qnc.module.media-probe"
  ],
  "runtime_crate": "qnc-media-records",
  "specification": "docs/31-media-record-database.md"
}
