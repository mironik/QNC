{
  "module_id": "qnc.module.ingest-work-plan",
  "module_name": "Ingest Work Plan",
  "module_version": "0.1.0",
  "module_kind": "library",
  "runtime_crate": "qnc-ingest-work-plan",
  "capabilities": [
    "ingest.work_plan.from_project_settings",
    "ingest.storage_roles.resolve"
  ],
  "input_contract_version": "0.1.0",
  "output_contract_version": "0.1.0",
  "supported_os": ["windows", "linux", "macos"],
  "supported_cpu": ["x86_64", "aarch64"],
  "transport_protocol_version": "0.1.0",
  "forbidden_calls": [
    "project.workflow",
    "project.settings.write",
    "source.scan.roles",
    "media.probe.full",
    "ffprobe",
    "player.playback",
    "timeline.paint",
    "filmstrip.generate",
    "wave.generate",
    "application.db.write"
  ],
  "forbidden_dependencies": [
    "qnc.module.dir-browser",
    "qnc.module.scanner",
    "qnc.module.source-reader",
    "qnc.module.media-probe",
    "qnc.module.ffprobe-metadata",
    "qnc.module.broadcast-player",
    "qnc.module.broadcast-engine",
    "qnc.module.timeline",
    "qnc.module.ui-widget"
  ],
  "state_policy": "stateless",
  "database_write_policy": "no_db_writes",
  "project_settings_policy": "read_only_input_only",
  "ui_policy": "no_form_or_paint_code"
}
