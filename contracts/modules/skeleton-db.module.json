{
  "module_id": "qnc.module.skeleton-db",
  "module_name": "S-Story Skeleton Table",
  "module_version": "0.1.0",
  "module_kind": "library",
  "capabilities": [
    "db.skeleton.read",
    "db.skeleton.write"
  ],
  "input_contract_version": "0.1.0",
  "output_contract_version": "0.1.0",
  "transport_protocol_version": "0.1.0",
  "transport_scope": [
    "local",
    "lan",
    "intranet"
  ],
  "supported_os": [
    "windows",
    "linux",
    "macos"
  ],
  "supported_cpu": [
    "x86_64",
    "aarch64"
  ],
  "state_policy": "session_local",
  "database_write_policy": "public_db_owner_write_adapter_only",
  "module_dependencies": [
    "qnc.module.db-broker"
  ],
  "forbidden_calls": [
    "media.decode",
    "media.probe.full",
    "file.write",
    "playback.clock"
  ],
  "forbidden_dependencies": [
    "qnc.module.media-probe",
    "qnc.module.scanner",
    "qnc.module.broadcast-player-core"
  ],
  "adapter_policy": "The list of S-Story versions (user 2026-10-31) as a table module of the project database intermediary (qnc-db-broker): skeleton_versions and the view public_skeleton_versions, numbered 1, 2, ... Each version is its own story in story-draft-<n>.db, written by the story module; this module owns only the list and is written only through the intermediary.",
  "specification": "AGENTS.md"
}
