{
  "module_id": "qnc.module.app-registry",
  "module_name": "Application registry",
  "module_version": "0.1.0",
  "module_kind": "library",
  "capabilities": [
    "registry.applications.load",
    "registry.applications.validate"
  ],
  "input_contract_version": "0.1.0",
  "output_contract_version": "0.1.0",
  "supported_os": [
    "windows",
    "linux",
    "macos"
  ],
  "supported_cpu": [
    "x86_64",
    "aarch64"
  ],
  "transport_protocol_version": "0.1.0",
  "forbidden_calls": [
    "ffprobe",
    "media.decode",
    "business.workflow",
    "player.command",
    "ui.paint",
    "database.read",
    "database.write"
  ],
  "forbidden_dependencies": [
    "qnc.module.media-probe",
    "qnc.module.scanner",
    "qnc.module.content-store"
  ],
  "state_policy": "stateless",
  "database_write_policy": "no_db_writes",
  "runtime_crate": "qnc-app-registry",
  "input": "The apps/*/qnc-app.json registrations under the QNC root.",
  "output": "The enabled QNC applications, validated and ordered by priority group. It hosts and starts nothing.",
  "specification": "User rule 2026-09-30: everything is a block; moved unchanged out of qnc-app."
}
