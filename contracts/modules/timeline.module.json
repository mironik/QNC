{
  "module_id": "qnc.module.timeline",
  "module_name": "Timeline Engine",
  "module_version": "0.1.0",
  "module_kind": "ui_widget",
  "capabilities": [
    "timeline.passive_projection",
    "timeline.frame_projection",
    "timeline.paint",
    "timeline.source_player.paint",
    "timeline.filmstrip_background.paint",
    "timeline.wave_peaks.paint",
    "timeline.hit_test",
    "timeline.intent.emit"
  ],
  "input_contract_version": "0.1.0",
  "output_contract_version": "0.1.0",
  "supported_os": ["windows", "linux", "macos"],
  "supported_cpu": ["x86_64", "aarch64"],
  "transport_protocol_version": "0.1.0",
  "forbidden_calls": [
    "ffprobe",
    "media.probe.full",
    "playback.clock.own",
    "playback.state.own",
    "playback.position.fallback",
    "playback.execute",
    "application.db.read",
    "application.db.write",
    "filmstrip.generate",
    "wave.generate"
  ],
  "forbidden_dependencies": [
    "qnc.module.player-contract",
    "qnc.module.player-client",
    "qnc.module.broadcast-player",
    "qnc.module.broadcast-player-core",
    "qnc.module.broadcast-engine",
    "qnc.module.media-probe",
    "qnc.module.ffprobe-metadata",
    "qnc.module.scanner",
    "qnc.module.source-reader",
    "qnc.module.filmstrip-worker",
    "qnc.module.wave-worker"
  ],
  "state_policy": "stateless",
  "engine_policy": "single_public_layered_ui_component",
  "playback_state_source": "broadcast_player",
  "state_input_policy": "caller_supplied_projection_only",
  "intent_policy": "emit_only",
  "database_write_policy": "no_db_writes",
  "state_owner": "qnc.module.broadcast-player",
  "ui_layers": [
    "carrier",
    "audio_a1",
    "base_video",
    "audio_a2",
    "audio_a3",
    "audio_a4",
    "virtual_spans",
    "covers",
    "markers",
    "marker_slots",
    "shot_range",
    "in_out",
    "playhead"
  ]
}
