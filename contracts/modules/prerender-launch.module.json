{
  "module_id": "qnc.module.prerender-launch",
  "module_name": "Prerender Wake",
  "module_version": "0.1.0",
  "module_kind": "library",
  "capabilities": [
    "program.prerender.wake"
  ],
  "input_contract_version": "0.1.0",
  "output_contract_version": "0.1.0",
  "transport_protocol_version": "0.1.0",
  "transport_scope": [
    "local",
    "lan",
    "intranet"
  ],
  "supported_os": [
    "windows",
    "linux",
    "macos"
  ],
  "supported_cpu": [
    "x86_64",
    "aarch64"
  ],
  "state_policy": "session_local",
  "database_write_policy": "no_db_writes",
  "module_dependencies": [
    "qnc.module.playback-activity",
    "qnc.module.content-store"
  ],
  "forbidden_calls": [
    "db.write",
    "media.decode",
    "media.probe.full",
    "file.write",
    "playback.clock"
  ],
  "forbidden_dependencies": [
    "qnc.module.media-probe",
    "qnc.module.scanner",
    "qnc.module.broadcast-player-core"
  ],
  "adapter_policy": "Wakes the background prerender of the active project (always on): reads its lease in the project database and, when it is not alive, starts the qnc-prerender executable beside the application, all on a thread of its own so the caller never waits for the database or a process start. It knows no form and no application.",
  "specification": "docs/70-replaceable-decoders.md"
}