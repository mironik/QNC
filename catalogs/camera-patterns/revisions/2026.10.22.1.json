{
  "base_version": "2026.10.19.1",
  "dataset_version": "2026.10.22.1",
  "changed_on": "2026-10-22",
  "sources": [
    {
      "id": "sony-fx3a-sd-observation",
      "kind": "card_observation",
      "publisher": "QNC read-only verification",
      "title": "FX3A SD card layout",
      "locator": "AGENTS.md section 18, 2026-10-22",
      "section": "Read-only listing of an ILME-FX3A SD card: PRIVATE/M4ROOT/MEDIAPRO.XML (MediaProfile 2.30), CLIP/*.MP4 with *M01.XML, SUB/*S03.MP4 HEVC proxies, THMBNL/*T01.JPG.",
      "reviewed_on": "2026-10-22"
    }
  ],
  "changes": [
    {
      "operation": "replace",
      "pattern": {
        "id": "sony-m4root-sd",
        "manufacturer": "Sony",
        "family": "M4ROOT / XAVC MP4 on SD",
        "applicability": "Documented ILCE-7M4; observed ILME-FX3A (XAVC-M4 2.00) SD card 2026-10-22: PRIVATE/M4ROOT with MEDIAPRO.XML, CLIP/*.MP4 with *M01.XML, SUB/*S03.MP4 proxies, THMBNL/*T01.JPG.",
        "naming_rule": "CLIP/{name}.MP4; CLIP/{name}M01.XML; SUB/{name}S03.MP4; THMBNL/{name}T01.JPG. Manifest URIs override suffix hints.",
        "evidence_level": "observed",
        "status": "enabled",
        "status_reason": "Read-only XML relationships on an FX3A SD card; same MediaProfile and NonRealTimeMeta namespaces as XDROOT.",
        "root_scope": "card_relative",
        "roots": [
          "PRIVATE/M4ROOT"
        ],
        "grouping_method": "manifest_references",
        "grouping_notes": "MEDIAPRO.XML Contents/Material gives original URI and nested Proxy/RelevantInfo URIs; scope UMID to the source and recording root.",
        "limitations": "Missing proxy is permitted. Do not assume every Sony MP4 is a proxy. Device serial is not card serial.",
        "files": [
          {
            "path": "CLIP/*.MP4",
            "role": "original_candidate",
            "condition": "Referenced Material or compatible sidecar identity."
          },
          {
            "path": "SUB/*S03.MP4",
            "role": "proxy_candidate",
            "condition": "Attach only to referenced original."
          },
          {
            "path": "CLIP/*M01.XML",
            "role": "metadata",
            "condition": "Non-real-time metadata."
          },
          {
            "path": "THMBNL/*T01.JPG",
            "role": "thumbnail",
            "condition": "RelevantInfo reference."
          },
          {
            "path": "MEDIAPRO.XML",
            "role": "index",
            "condition": "Camera media manifest."
          }
        ],
        "metadata": [
          {
            "document": "MEDIAPRO.XML",
            "namespace": "http://xmlns.sony.net/pro/metadata/mediaprofile",
            "selector": "Contents/Material/@uri",
            "meaning": "Original relative URI; never an OS absolute path."
          },
          {
            "document": "MEDIAPRO.XML",
            "namespace": "http://xmlns.sony.net/pro/metadata/mediaprofile",
            "selector": "Contents/Material/Proxy/@uri",
            "meaning": "Proxy associated with parent Material."
          },
          {
            "document": "MEDIAPRO.XML",
            "namespace": "http://xmlns.sony.net/pro/metadata/mediaprofile",
            "selector": "Contents/Material/RelevantInfo/@uri",
            "meaning": "Related metadata or thumbnail, with type attribute."
          },
          {
            "document": "MEDIAPRO.XML",
            "namespace": "http://xmlns.sony.net/pro/metadata/mediaprofile",
            "selector": "Properties/Attached/@mediaId",
            "meaning": "Camera media identifier, not physical card or volume serial."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "TargetMaterial/@umidRef",
            "meaning": "Original identity link."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "Device/@modelName",
            "meaning": "Camera model; Device/@serialNo identifies camera only."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "CreationDate/@value",
            "meaning": "Camera clip creation time including recorded timezone offset."
          },
          {
            "document": "MEDIAPRO.XML",
            "namespace": "http://xmlns.sony.net/pro/metadata/mediaprofile",
            "selector": "Contents/Material/@umid",
            "meaning": "Original identity within recording root; not proxy identity."
          },
          {
            "document": "MEDIAPRO.XML",
            "namespace": "http://xmlns.sony.net/pro/metadata/mediaprofile",
            "selector": "Contents/Material/@dur",
            "meaning": "Declared duration units; exact frames only with verified mode/FPS semantics."
          },
          {
            "document": "MEDIAPRO.XML",
            "namespace": "http://xmlns.sony.net/pro/metadata/mediaprofile",
            "selector": "Contents/Material/@fps",
            "meaning": "Declared format FPS, not LTC timecode rate."
          },
          {
            "document": "MEDIAPRO.XML",
            "namespace": "http://xmlns.sony.net/pro/metadata/mediaprofile",
            "selector": "Contents/Material/@videoType",
            "meaning": "Camera video codec declaration, not filename extension."
          },
          {
            "document": "MEDIAPRO.XML",
            "namespace": "http://xmlns.sony.net/pro/metadata/mediaprofile",
            "selector": "Contents/Material/@audioType",
            "meaning": "Camera audio codec description; not complete per-stream format."
          },
          {
            "document": "MEDIAPRO.XML",
            "namespace": "http://xmlns.sony.net/pro/metadata/mediaprofile",
            "selector": "Contents/Material/@ch",
            "meaning": "Camera audio channel count, not container stream count/index."
          },
          {
            "document": "MEDIAPRO.XML",
            "namespace": "http://xmlns.sony.net/pro/metadata/mediaprofile",
            "selector": "Contents/Material/Proxy/@dur",
            "meaning": "Own proxy duration; missing value must not inherit original dur."
          },
          {
            "document": "MEDIAPRO.XML",
            "namespace": "http://xmlns.sony.net/pro/metadata/mediaprofile",
            "selector": "Contents/Material/Proxy/@fps",
            "meaning": "Own proxy FPS; missing value is unresolved."
          },
          {
            "document": "MEDIAPRO.XML",
            "namespace": "http://xmlns.sony.net/pro/metadata/mediaprofile",
            "selector": "Contents/Material/Proxy/@audioType",
            "meaning": "Own proxy audio codec, may differ from original."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "Duration/@value",
            "meaning": "Duration units, interpreted with verified format FPS and recording mode."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "VideoFormat/VideoFrame/@formatFps",
            "meaning": "Recorded video format FPS; captureFps and tcFps are distinct."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "VideoFormat/VideoFrame/@captureFps",
            "meaning": "Capture rate; may differ in slow/quick recording."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "VideoFormat/VideoFrame/@videoCodec",
            "meaning": "Sidecar video codec declaration; preserve conflicts with index."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "VideoFormat/VideoLayout/@pixel",
            "meaning": "Explicit video width."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "VideoFormat/VideoLayout/@numOfVerticalLine",
            "meaning": "Explicit video height."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "AudioFormat/@numOfChannel",
            "meaning": "Camera channel count, not evidence of container stream mapping."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "AudioFormat/AudioRecPort/@trackDst",
            "meaning": "Camera CH port label; do not invent container stream index."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "AudioFormat/AudioRecPort/@audioCodec",
            "meaning": "Codec declaration per camera recording port."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "LtcChangeTable/@tcFps",
            "meaning": "Timecode base only, not video format FPS."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "RecordingMode/@type",
            "meaning": "Gate for interpreting normal/slow/quick duration semantics."
          },
          {
            "document": "CLIP/*M01.XML",
            "namespace": "urn:schemas-professionalDisc:nonRealTimeMeta:ver.2.20",
            "selector": "AcquisitionRecord/Group/Item/@value",
            "meaning": "Named camera acquisition values; capture settings are not automatically coded stream color metadata."
          }
        ],
        "evidence": [
          {
            "source": "sony-a7iv",
            "supports": "SD PRIVATE/M4ROOT/CLIP and SUB."
          },
          {
            "source": "sony-fx3a-sd-observation",
            "supports": "MEDIAPRO.XML Material/Proxy/RelevantInfo references, M01.XML NonRealTimeMeta ver.2.20, THMBNL; 9 clips."
          },
          {
            "source": "sony-xml-reader-observation",
            "supports": "Same index and sidecar namespaces and selectors as XDROOT."
          }
        ]
      },
      "reason": "An FX3A SD card gave no clips (user 2026-10-22: new card, new camera): the M4ROOT pattern had no index or metadata selectors, so no index reader grouped its clips. Adds MEDIAPRO.XML as index and the Sony selectors; roots unchanged."
    }
  ]
}